#!/bin/sh
# Refresh installed packages when the inventory changes.
#
# chezmoi re-runs a run_onchange_ script whenever the rendered contents of the
# script change. Embedding a hash of the inventory below is what couples the
# two: edit .chezmoidata/packages.yaml, and the next `chezmoi apply` runs this.
#
# inventory sha256: {{ .packages | toJson | sha256sum }}
#
# Inert until bhell is installed, so it is safe on a machine that has never
# had it. `bhell apply` must be idempotent - chezmoi will re-run this on every
# machine that pulls an inventory change.

set -eu

if ! command -v bhell >/dev/null 2>&1; then
    echo "bhell not installed; skipping package sync" >&2
    exit 0
fi

exec bhell apply --config "{{ .chezmoi.sourceDir }}/.chezmoidata/packages.yaml"
