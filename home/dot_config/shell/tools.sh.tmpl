# ~/.config/shell/tools.sh - third-party shell integrations.
#
# GENERATED by chezmoi from .chezmoidata/shell.yaml - edit that, then
# `chezmoi apply`. Changes made here are overwritten.

# Name of the running shell, for tools that emit shell-specific init code.
if   [ -n "${ZSH_VERSION-}" ];  then __SHELL_NAME=zsh
elif [ -n "${BASH_VERSION-}" ]; then __SHELL_NAME=bash
elif [ -n "${KSH_VERSION-}" ];  then __SHELL_NAME=ksh
else                                 __SHELL_NAME=sh
fi

# Evaluate a tool's startup hook, but only if the tool exists and the hook
# actually produces something. A tool that does not support this shell is
# skipped rather than spraying errors across every new terminal.
__shell_init() {
    command -v "$1" >/dev/null 2>&1 || return 0
    __init_output="$("$@" 2>/dev/null)" || { unset __init_output; return 0; }
    [ -n "${__init_output}" ] && eval "${__init_output}"
    unset __init_output
}

{{ range .shell.init -}}
__shell_init {{ .cmd }} {{ printf .args "\"${__SHELL_NAME}\"" }}
{{ end }}
