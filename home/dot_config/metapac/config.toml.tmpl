{{- $platform := includeTemplate "metapac-platform" . -}}
{{- $enabled := includeTemplate "metapac-backends" . | trim | splitList " " -}}
# Generated by chezmoi from .chezmoidata/packages.yaml. Do not edit.
#
# Edit ~/.local/share/chezmoi/home/.chezmoidata/packages.yaml and run
# `chezmoi apply`. Everything in this directory is regenerated from it.
#
# platform: {{ $platform }}
#
# Order here is metapac's enabled-backend list, which metapac itself treats as
# unordered - it queries every enabled backend independently. The ordering that
# actually decides which backend installs a given tool is applied earlier, when
# chezmoi renders groups/dotfiles.toml, so each tool appears under exactly one
# backend by the time metapac sees it.
enabled_backends = [{{ range $i, $b := $enabled }}{{ if $i }}, {{ end }}"{{ $b }}"{{ end }}]

[cargo]
locked = true
