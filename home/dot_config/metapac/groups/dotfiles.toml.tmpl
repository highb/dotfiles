{{- /*
GENERATED by chezmoi from .chezmoidata/packages.yaml - do not edit.

This template is the resolution layer metapac does not have. metapac treats
every enabled backend independently, so a tool listed under both apt and brew
is installed twice. Here each tool is declared once and assigned to exactly
one backend, chosen by priority, with fallback when the preferred backend has
no entry for it or is not used on this platform.
*/ -}}
{{- $platform := includeTemplate "metapac-platform" . -}}
{{- $enabled := includeTemplate "metapac-backends" . | trim | splitList " " -}}

{{- /* Resolve: for each active tool, walk prefer ++ platform priority and
       take the first backend that is enabled here and knows the tool. */ -}}
{{- $assigned := dict -}}
{{- $unresolved := list -}}
{{- range $name, $tool := .packages.tools -}}
{{-   if eq $tool.status "active" -}}
{{-     $prefer := get $tool "prefer" | default (list) -}}
{{-     $provs := get $tool "providers" | default (dict) -}}
{{-     $candidates := concat $prefer $enabled -}}
{{-     $chosen := "" -}}
{{-     range $backend := $candidates -}}
{{-       if and (eq $chosen "") (has $backend $enabled) (hasKey $provs $backend) -}}
{{-         $chosen = $backend -}}
{{-       end -}}
{{-     end -}}
{{-     if eq $chosen "" -}}
{{-       $unresolved = append $unresolved $name -}}
{{-     else -}}
{{-       $entry := index $provs $chosen -}}
{{-       $current := get $assigned $chosen | default (list) -}}
{{-       $_ := set $assigned $chosen (append $current (dict "tool" $name "spec" $entry)) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
# Generated by chezmoi from .chezmoidata/packages.yaml. Do not edit.
# platform: {{ $platform }}
# backends present here: {{ $enabled | join ", " }}
{{ range $backend := $enabled }}
{{- $items := get $assigned $backend | default (list) }}
{{- if $items }}
{{ $backend }} = { packages = [
{{- range $item := $items }}
{{- $opts := get $item.spec "options" | default (dict) }}
{{- $pairs := list }}
{{- range $k, $v := $opts }}{{ $pairs = append $pairs (printf "%s = %s" $k (includeTemplate "toml-value" $v)) }}{{ end }}
  { name = "{{ $item.spec.name }}"{{ if $opts }}, options = { {{ $pairs | join ", " }} }{{ end }} },
{{- end }}
] }
{{- end }}
{{- end }}
{{ if $unresolved }}
# UNRESOLVED - declared active but no backend available on {{ $platform }}:
{{- range $u := $unresolved }}
#   {{ $u }}
{{- end }}
{{ end -}}
