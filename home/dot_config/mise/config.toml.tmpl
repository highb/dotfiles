{{- /*
GENERATED by chezmoi from .chezmoidata/packages.yaml - do not edit.

Every tool here is one whose backend resolution landed on `mise` for this
machine, using the same prefer ++ priority walk as the metapac group file.
Sharing that walk is the point: `metapac sync` installs mise tools by running
`mise use --global`, which writes into this very file. When the two are
derived from the same source they agree and nothing thrashes; when they are
not, metapac adds a line and the next `chezmoi apply` deletes it.

So a tool is added by giving it a `mise` provider in packages.yaml, not by
editing here and not by running `mise use --global` - that write survives only
until the next apply.

Ordering is alphabetical by the name mise knows the tool as, which is why the
`npm:` and `github:` entries sort where they do. The human-readable grouping
this file used to carry now lives in packages.yaml.
*/ -}}
{{- $platform := includeTemplate "metapac-platform" . -}}
{{- $enabled := includeTemplate "metapac-backends" . | trim | splitList " " -}}
{{- $tools := dict -}}
{{- range $name, $tool := .packages.tools -}}
{{-   if eq $tool.status "active" -}}
{{-     $prefer := get $tool "prefer" | default (list) -}}
{{-     $provs := get $tool "providers" | default (dict) -}}
{{-     $chosen := "" -}}
{{-     range $b := concat $prefer $enabled -}}
{{-       if and (eq $chosen "") (has $b $enabled) (hasKey $provs $b) -}}{{- $chosen = $b -}}{{- end -}}
{{-     end -}}
{{-     if eq $chosen "mise" -}}
{{-       $entry := index $provs "mise" -}}
{{-       $opts := get $entry "options" | default (dict) -}}
{{-       $_ := set $tools $entry.name (get $opts "version" | default "latest") -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
# Global tool versions. Generated by chezmoi from .chezmoidata/packages.yaml.
# Do not edit - `mise use --global` writes here too, and loses on next apply.
#
#   $EDITOR ~/.local/share/chezmoi/home/.chezmoidata/packages.yaml
#   chezmoi apply          # regenerate this file and the metapac groups
#   metapac sync           # install whatever is now missing
#
# platform: {{ $platform }}
{{ if not (has "mise" $enabled) -}}
# mise is not a usable backend on this machine, so no tools resolved to it.
{{ end -}}
[tools]
{{- range $name, $version := $tools }}
{{ if regexMatch "^[A-Za-z0-9_-]+$" $name }}{{ $name }}{{ else }}"{{ $name }}"{{ end }} = "{{ $version }}"
{{- end }}
