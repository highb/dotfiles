# Repositories under ~/src/codeberg commit as the Codeberg identity.
# This previously keyed on ~/code/work/, a directory that does not exist on
# any current machine, so the include never fired and those repositories
# silently used the GitHub identity above.
[includeIf "gitdir:~/src/codeberg/"]
	path = ~/src/codeberg/.gitconfig

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/opt/1Password/op-ssh-sign"
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[checkout]
	defaultRemote = origin
[init]
	defaultBranch = main
