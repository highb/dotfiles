{{- $machine := get . "machine" | default dict -}}
{{ if ne .chezmoi.os "darwin" -}}
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
{{ end -}}
[user]
	name = Brandon High
	email = 759848+highb@users.noreply.github.com
	signingkey = {{ get $machine "gitSigningKey" | default "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJjmSuai7qgc96vL5VKBGT5xlA7Q87cAmjyL/+m1vVTW" | quote }}

# Repositories under ~/src/codeberg commit as the Codeberg identity.
# This previously keyed on ~/code/work/, a directory that does not exist on
# any current machine, so the include never fired and those repositories
# silently used the GitHub identity above.
[includeIf "gitdir:~/src/codeberg/"]
	path = ~/src/codeberg/.gitconfig

[gpg]
  format = ssh

[gpg "ssh"]
  program = {{ if eq .chezmoi.os "darwin" }}"/Applications/1Password.app/Contents/MacOS/op-ssh-sign"{{ else }}"/opt/1Password/op-ssh-sign"{{ end }}
  allowedSignersFile = {{ get $machine "gitAllowedSignersFile" | default "~/.config/git/allowed_signers" | quote }}

[commit]
  gpgsign = true

[checkout]
	defaultRemote = origin
[init]
	defaultBranch = main
