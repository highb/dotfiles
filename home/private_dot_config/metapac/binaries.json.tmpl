{{- /* tool -> the binary it actually installs, for the backend it resolved to.
       apt's bat is batcat and mise's bat is bat, so this is a property of the
       pair, not of the tool. Consumed by ~/bin/pkg-doctor. */ -}}
{{- $resolution := includeTemplate "package-resolution" . | fromJson -}}
{{- $map := dict -}}
{{- range $backend, $items := $resolution.assigned -}}
{{-   range $item := $items -}}
{{-     $_ := set $map $item.tool (get $item.spec "binary" | default $item.tool) -}}
{{-   end -}}
{{- end -}}
{{ $map | toPrettyJson }}
