{{- /*
GENERATED by chezmoi from .chezmoidata/packages.yaml - do not edit.

This template is the resolution layer metapac does not have. metapac treats
every enabled backend independently, so a tool listed under both apt and brew
is installed twice. Here each tool is declared once and assigned to exactly
one backend, chosen by priority, with fallback when the preferred backend has
no entry for it or is not used on this platform.
*/ -}}
{{- $resolution := includeTemplate "package-resolution" . | fromJson -}}
{{- $platform := $resolution.platform -}}
{{- $enabled := $resolution.enabled -}}
{{- $assigned := $resolution.assigned -}}
{{- $unresolved := $resolution.unresolved -}}
# Generated by chezmoi from .chezmoidata/packages.yaml. Do not edit.
# platform: {{ $platform }}
# selected package groups: {{ $resolution.selection.groups | join ", " | default "(none)" }}
# backends present here: {{ $enabled | join ", " }}
{{ range $backend := $enabled }}
{{- $items := get $assigned $backend | default (list) }}
{{- if $items }}
{{ $backend }} = { packages = [
{{- range $item := $items }}
{{- $opts := get $item.spec "options" | default (dict) }}
{{- $pairs := list }}
{{- range $k, $v := $opts }}{{ $pairs = append $pairs (printf "%s = %s" $k (includeTemplate "toml-value" $v)) }}{{ end }}
  { name = "{{ $item.spec.name }}"{{ if $opts }}, options = { {{ $pairs | join ", " }} }{{ end }} },
{{- end }}
] }
{{- end }}
{{- end }}
{{ if $unresolved }}
# UNRESOLVED - declared active but no backend available on {{ $platform }}:
{{- range $u := $unresolved }}
#   {{ $u }}
{{- end }}
{{ end -}}
