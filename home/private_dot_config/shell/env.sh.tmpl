# ~/.config/shell/env.sh - environment shared by every POSIX shell.
#
# GENERATED by chezmoi from .chezmoidata/shell.yaml - edit that, then
# `chezmoi apply`. Changes made here are overwritten.
#
# Sourced by login shells (.profile, .zshenv) and again by interactive ones.
# Every operation is idempotent, so re-sourcing is always safe.

# Prepend a directory to PATH, moving it to the front if it is already
# somewhere else. Skipping an entry that is already present would be simpler,
# but then whichever system script happened to run between our two sourcings
# would keep the priority it grabbed - which is exactly how zsh ended up
# preferring the nix profile over ~/bin while bash did not. Rebuilding puts
# the order declared in shell.yaml in charge, whoever else touched PATH.
__path_prepend() {
    [ -d "$1" ] || return 0
    __pp_kept=""
    __pp_rest="${PATH}"
    while [ -n "${__pp_rest}" ]; do
        __pp_head="${__pp_rest%%:*}"
        case "${__pp_rest}" in
            *:*) __pp_rest="${__pp_rest#*:}" ;;
            *)   __pp_rest="" ;;
        esac
        [ -z "${__pp_head}" ] && continue
        [ "${__pp_head}" = "$1" ] && continue
        __pp_kept="${__pp_kept:+${__pp_kept}:}${__pp_head}"
    done
    PATH="$1${__pp_kept:+:${__pp_kept}}"
    unset __pp_kept __pp_rest __pp_head
}

{{ range reverse .shell.path -}}
__path_prepend "{{ . }}"
{{ end -}}
export PATH

{{ range $name, $value := .shell.env -}}
export {{ $name }}="{{ $value }}"
{{ end }}

# Machine-local environment and integration policy, never committed.
if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.local.sh" ]; then
    . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/env.local.sh"
fi
