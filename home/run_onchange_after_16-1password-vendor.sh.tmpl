#!/bin/sh
# Official sources and verification references: docs/1password.md
# install consent: {{ eq (env "DOTFILES_INSTALL_PACKAGES") "1" }}
{{- $r := includeTemplate "package-resolution" . | fromJson }}
{{- $wanted := get $r.assigned "1password-vendor" | default list }}
# selected vendor packages: {{ $wanted | toJson }}
set -eu
{{ if get (get . "machine" | default dict) "manualProvisioning" }}
exit 0 # Manual provisioning.
{{ else if not $wanted }}
{{ range $r.unresolved }}{{ if or (eq . "1password") (eq . "1password-cli") }}
echo '1Password: unsupported platform or unavailable/disabled native vendor provider; no fallback.' >&2
{{ end }}{{ end }}
exit 0
{{ else }}
{{ includeTemplate "package-runtime" . }}
# Check architecture even when an existing installation would skip work.
arch=$(uname -m)
{{ if eq .chezmoi.os "darwin" }}
case "$arch" in x86_64|arm64) ;; *) echo "Unsupported 1Password macOS architecture: $arch" >&2; exit 1 ;; esac
{{ else }}
# The desktop RPM repository supports x86_64. ARM CLI-only is supported too.
case "$arch" in
    x86_64) ;;
    aarch64) {{ if hasKey $r.selection.tools "1password" }}echo "Unsupported 1Password desktop RPM architecture: $arch" >&2; exit 1{{ else }}:{{ end }} ;;
    *) echo "Unsupported 1Password RPM architecture: $arch" >&2; exit 1 ;;
esac
{{ end }}
set --
{{ range $wanted }}
{{ if eq $.chezmoi.os "darwin" }}
{{ if eq .tool "1password" }}
if [ ! -d /Applications/1Password.app ] && [ ! -d "$HOME/Applications/1Password.app" ] && ! package_have 1password; then set -- "$@" 1password; fi
{{ else }}
package_have op || [ -x /usr/local/bin/op ] || set -- "$@" 1password-cli
{{ end }}
{{ else }}
if ! rpm -q {{ .tool }} >/dev/null 2>&1 && ! package_have {{ get .spec "binary" | default .tool }}; then set -- "$@" {{ .tool }}; fi
{{ end }}
{{ end }}
[ "$#" -gt 0 ] || exit 0
package_consent || exit 0
for tool in curl sudo; do
    package_have "$tool" || { echo "Install $tool before provisioning 1Password." >&2; exit 1; }
done
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
fetch() {
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --tlsv1.2 "$1" -o "$2"
}
{{ if eq .chezmoi.os "darwin" }}
# pkgutil validates the certificate chain; Gatekeeper checks trust/notarization.
# Pin the published AgileBits installer certificate as well as the developer ID.
verify_pkg() {
    pkgutil --check-signature "$1" > "$work/signature"
    grep -F 'Developer ID Installer: AgileBits Inc. (2BUA8C4S2C)' "$work/signature" >/dev/null
    tr -d '[:space:]:' < "$work/signature" > "$work/fingerprints"
    case "$2" in
        1password) pins='FA3D247EB500F5900A063FF371533E8F7371C282E06D2A718E8E42D722F979CC|141DD87B2B231211F1440849798007DF621DE6EB3DAB985BC964EE9704C4A1C1' ;;
        1password-cli) pins='CAB578061B0209FB70934DA344EF6FEBCD3279B1C074C54B0D7D555743B9D89F|141DD87B2B231211F1440849798007DF621DE6EB3DAB985BC964EE9704C4A1C1' ;;
    esac
    grep -E "$pins" "$work/fingerprints" >/dev/null
    spctl --assess --type install --verbose=2 "$1"
}
# Verify every missing tool before installing either one.
for tool do
    case "$tool" in
        1password) url=https://downloads.1password.com/mac/1Password.pkg ;;
        1password-cli) url=https://cache.agilebits.com/dist/1P/op2/pkg/v2.41.0/op_apple_universal_v2.41.0.pkg ;;
    esac
    fetch "$url" "$work/$tool.pkg"
    # A function used as an if-condition needs explicit checks: set -e is disabled
    # inside it in POSIX shells. Invoke directly so every failed check is fatal.
    verify_pkg "$work/$tool.pkg" "$tool"
done
for tool do sudo installer -pkg "$work/$tool.pkg" -target /; done
{{ else }}
package_have gpg || { echo 'Install GnuPG before configuring the signed 1Password repository.' >&2; exit 1; }
mkdir -m 700 "$work/gnupg"
export GNUPGHOME="$work/gnupg"
fetch https://downloads.1password.com/linux/keys/1password.asc "$work/key.asc"
gpg --batch --with-colons --show-keys "$work/key.asc" > "$work/key-info"
[ "$(awk -F: '$1 == "pub" { n++ } END { print n+0 }' "$work/key-info")" = 1 ] || {
    echo 'Unexpected 1Password signing-key bundle; refusing repository setup.' >&2
    exit 1
}
fingerprint=$(awk -F: '$1 == "fpr" { print $10; exit }' "$work/key-info")
[ "$fingerprint" = 3FEF9748469ADBE15DA7CA80AC2D62742012EA22 ] || {
    echo '1Password signing-key fingerprint mismatch; refusing repository setup.' >&2
    exit 1
}
{{ if lookPath "rpm-ostree" }}
# Repository-scoping flags are unavailable on the host rpm-ostree client.
# Download official RPMs and verify with ONLY the pinned key in a temporary DB,
# so an unrelated repository cannot supply either 1Password package.
mkdir "$work/rpmdb"
rpm --dbpath "$work/rpmdb" --initdb
rpm --dbpath "$work/rpmdb" --import "$work/key.asc"
for tool do
    case "$tool" in
        1password) url="https://downloads.1password.com/linux/rpm/stable/$arch/1password-latest.rpm" ;;
        1password-cli) url="https://downloads.1password.com/linux/rpm/stable/$arch/1password-cli-latest.$arch.rpm" ;;
    esac
    fetch "$url" "$work/$tool.rpm"
    rpm --dbpath "$work/rpmdb" --checksig --verbose "$work/$tool.rpm" > "$work/rpm-signature"
    # rpm can return success for digest-only unsigned packages. Require an
    # actual valid signature, and reject missing keys or invalid signatures.
    grep -Ei '(RSA|DSA|ECDSA).*Signature.*: OK$' "$work/rpm-signature" >/dev/null
    if grep -Ei 'NOKEY|NOT OK|BAD|NOTTRUSTED' "$work/rpm-signature" >/dev/null; then
        echo 'Invalid 1Password RPM signature; refusing installation.' >&2
        exit 1
    fi
done
# All missing RPMs have passed verification before either one is layered.
sudo rpm-ostree install --idempotent -y "$work"/*.rpm
echo '1Password layered deployment prepared. Reboot to use newly installed packages.' >&2
{{ else }}
# One canonical repository, shared by both tools. Do not add a duplicate next to
# an existing differently named vendor repository; ask for reconciliation instead.
for repo in /etc/yum.repos.d/*.repo; do
    [ -f "$repo" ] || continue
    [ "$repo" = /etc/yum.repos.d/1password.repo ] && continue
    if grep -E 'downloads\.1password\.com/linux/rpm|^\[1password\]' "$repo" >/dev/null; then
        echo "Existing 1Password repository in $repo; reconcile it with /etc/yum.repos.d/1password.repo first." >&2
        exit 1
    fi
done
cat > "$work/1password.repo" <<'REPO'
[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/1password.asc
REPO
sudo install -d /etc/pki/rpm-gpg /etc/yum.repos.d
cmp -s "$work/key.asc" /etc/pki/rpm-gpg/1password.asc || sudo install -m 0644 "$work/key.asc" /etc/pki/rpm-gpg/1password.asc
cmp -s "$work/1password.repo" /etc/yum.repos.d/1password.repo || sudo install -m 0644 "$work/1password.repo" /etc/yum.repos.d/1password.repo
sudo rpm --import /etc/pki/rpm-gpg/1password.asc
# Restrict these names to the vendor repository; force both signature checks.
sudo dnf --setopt='*.excludepkgs=1password,1password-cli' --setopt=1password.excludepkgs= --setopt=1password.gpgcheck=1 --setopt=1password.repo_gpgcheck=1 install -y "$@"
{{ end }}
{{ end }}
{{ end }}
