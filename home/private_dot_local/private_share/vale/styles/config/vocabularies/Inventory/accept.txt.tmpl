{{- /* Generated by chezmoi from .chezmoidata/packages.yaml. Do not edit.
       Every tool name in the inventory, plus the name each package manager
       knows it by and the package managers' own names, so Vale.Spelling stops
       reporting the machine's own toolchain. Hand-maintained words belong in
       the Local vocabulary beside this one.

       The whole inventory is rendered, not the selected groups: a vocabulary
       is about words that appear in writing, and deselecting a group on one
       machine should not turn that machine's notes into spelling errors.

       An all-lowercase name is rendered case-insensitive, because Vale.Terms
       enforces the exact casing of whatever an accept list holds, and a
       sentence may legitimately open with "Chezmoi" or "Ripgrep". Each entry
       also takes an optional possessive, since "chezmoi's" is one token to
       Vale and would otherwise be reported on its own. */ -}}
{{- /* Rendered from the whole inventory, so the group selection is not read
       here. It is still validated, so that one bad machine.packageGroups fails
       every rendered file rather than all but this one. */ -}}
{{- $_ := includeTemplate "package-selection" . | fromJson -}}
{{- $names := list -}}
{{- range $backend, $binary := (get .packages "backend_binaries" | default dict) -}}
{{-   $names = append $names $backend -}}
{{-   $names = append $names $binary -}}
{{- end -}}
{{- range $id, $tool := .packages.tools -}}
{{-   $names = append $names $id -}}
{{-   range $backend, $spec := (get $tool "providers" | default dict) -}}
{{-     range $key := (list "name" "binary") -}}
{{-       $value := get $spec $key | default "" -}}
{{-       if $value -}}
{{-         $bare := $value | splitList ":" | last | splitList "/" | last -}}
{{-         if $bare -}}{{- $names = append $names $bare -}}{{- end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
# Generated by chezmoi from .chezmoidata/packages.yaml. Do not edit.
# Run `chezmoi apply` to regenerate. Hand-maintained words go in ../Local.
{{ range $name := ($names | uniq | sortAlpha) -}}
{{ if eq $name (lower $name) }}(?i){{ end }}{{ regexQuoteMeta $name }}('s)?
{{ end -}}
