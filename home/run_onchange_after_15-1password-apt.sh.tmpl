#!/bin/sh
# Official instructions:
# https://support.1password.com/install-linux/#debian-or-ubuntu
# https://developer.1password.com/docs/cli/get-started/#install
# install consent: {{ eq (env "DOTFILES_INSTALL_PACKAGES") "1" }}
{{- $r := includeTemplate "package-resolution" . | fromJson }}
{{- $wanted := list }}
{{- range (get $r.assigned "apt" | default list) }}
{{- if or (eq .tool "1password") (eq .tool "1password-cli") }}
{{- $wanted = append $wanted .tool }}
{{- end }}{{- end }}
# selected vendor packages: {{ $wanted | join ", " | default "(none)" }}
set -eu
{{ if not $wanted }}
exit 0 # No selected 1Password packages assigned to APT.
{{ else }}
{{ includeTemplate "package-runtime" . }}
package_consent || exit 0
for tool in curl gpg dpkg sudo; do
    package_have "$tool" || { echo "Install $tool before configuring the signed 1Password repository." >&2; exit 1; }
done
arch=$(dpkg --print-architecture)
case "$arch" in amd64|arm64|armhf|i386) ;; *) echo "Unsupported 1Password APT architecture: $arch" >&2; exit 1 ;; esac
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT HUP INT TERM
mkdir -m 700 "$work/gnupg"
export GNUPGHOME="$work/gnupg"
curl --fail --silent --show-error --proto '=https' --tlsv1.2 \
    https://downloads.1password.com/linux/keys/1password.asc -o "$work/key.asc"
# Pin the primary signing-key fingerprint published in the official guide.
gpg --batch --with-colons --show-keys "$work/key.asc" > "$work/key-info"
fingerprint=$(awk -F: '$1 == "fpr" { print $10; exit }' "$work/key-info")
[ "$fingerprint" = 3FEF9748469ADBE15DA7CA80AC2D62742012EA22 ] || {
    echo "1Password signing-key fingerprint mismatch; refusing repository setup." >&2
    exit 1
}
gpg --batch --dearmor --output "$work/key.gpg" "$work/key.asc"
curl --fail --silent --show-error --proto '=https' --tlsv1.2 \
    https://downloads.1password.com/linux/debian/debsig/1password.pol -o "$work/1password.pol"
printf 'deb [arch=%s signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/%s stable main\n' "$arch" "$arch" > "$work/1password.list"
sudo install -d /usr/share/keyrings /etc/apt/sources.list.d \
    /etc/debsig/policies/AC2D62742012EA22 /usr/share/debsig/keyrings/AC2D62742012EA22
sudo install -m 0644 "$work/key.gpg" /usr/share/keyrings/1password-archive-keyring.gpg
sudo install -m 0644 "$work/key.gpg" /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
sudo install -m 0644 "$work/1password.pol" /etc/debsig/policies/AC2D62742012EA22/1password.pol
sudo install -m 0644 "$work/1password.list" /etc/apt/sources.list.d/1password.list
# APT verifies signed repository metadata and package hashes. Never opt out of
# authentication. The following metapac hook installs the declared native packages.
sudo apt-get update
{{ end }}
