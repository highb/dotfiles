# ~/.config/nvim is a git checkout in its own right. chezmoi owns the config
# under it; git owns the repository metadata. Never let `chezmoi add -r` pull
# one into the other again.
.config/nvim/.git
.config/nvim/.github

# Machine-local shell overrides, sourced by .bashrc/.zshrc if present.
.bashrc.local
.zshrc.local
.config/shell/env.local.sh

# Shell history is machine-local data, never a dotfile to sync.
.bash_history
.bash_history.*
.zsh_history
.zsh_history.*
.zsh_histfile
.zsh_histfile.*

# Deploy complete config bundles for the selected tasks. Ignoring a target
# stops managing it; it does not remove an existing copy from this machine.
{{- $selection := includeTemplate "package-selection" . | fromJson }}
{{- $groups := $selection.groups }}
{{ if not (has "shell" $groups) }}
.bashrc
.zshrc
.profile
.zshenv
.config/shell
.config/shell/**
.config/starship.toml
{{ end }}
{{ if not (or (has "core" $groups) (has "development" $groups)) }}
.gitconfig
.config/git
.config/git/**
{{ end }}
{{ if not (has "development" $groups) }}
.config/nvim
.config/nvim/**
bin/all_pull.sh
bin/gh_clone_all.sh
{{ end }}
{{ if not (or (has "development" $groups) (has "writing" $groups)) }}
bin/scaffold
.local/share/scaffold
.local/share/scaffold/**
{{ end }}
{{ if not (has "desktop" $groups) }}
.config/ghostty
.config/ghostty/**
{{ end }}
# These helpers require Linux desktop services, not merely a shell.
{{ if or (not (has "desktop" $groups)) (ne .chezmoi.os "linux") }}
bin/audio_fix.sh
bin/gnome_toggle_dark_mode.sh
{{ end }}

# This machine provisions packages explicitly, not during dotfile updates.
{{- $machine := get . "machine" | default dict }}
{{ if get $machine "manualProvisioning" }}
10-mise-direct.sh
20-metapac-sync.sh
{{ end }}

*.bak
.DS_Store
