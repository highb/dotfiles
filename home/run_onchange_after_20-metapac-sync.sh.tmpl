#!/bin/sh
# Refresh installed packages when the inventory changes.
#
# chezmoi re-runs a run_onchange_ script when its rendered contents change.
# The hash below is what couples the two: edit .chezmoidata/packages.yaml, and
# the next `chezmoi apply` runs this. It is taken over the parsed data, so
# reformatting and comment-only edits do not trigger a resync.
#
# inventory sha256: {{ .packages | toJson | sha256sum }}
# install consent: {{ eq (env "DOTFILES_INSTALL_PACKAGES") "1" }}
{{- $selection := includeTemplate "package-selection" . | fromJson }}
# selected package groups: {{ $selection.groups | join ", " | default "(none)" }}
{{- $machine := get . "machine" | default (dict) }}
{{- $providers := get $machine "packageProviders" | default (dict) }}
{{- $excludes := get $machine "packageExcludes" | default (list) }}
# machine package policy sha256: {{ dict "groups" $selection.groups "groupsExplicit" $selection.groupsExplicit "providers" $providers "excludes" $excludes | toJson | sha256sum }}
#
# `metapac sync` has no dry-run and installs system packages, some under sudo.
# Only DOTFILES_INSTALL_PACKAGES=1 authorizes installation, with or without a
# terminal. Consent is rendered above so a skipped apply can be opted into later.

set -eu

{{ if not $selection.tools -}}
exit 0 # No selected packages.
{{ end -}}
if [ "${DOTFILES_INSTALL_PACKAGES:-}" != "1" ]; then
    echo "Skipping package sync. Review packages, then run:" >&2
    echo "  DOTFILES_INSTALL_PACKAGES=1 chezmoi apply" >&2
    exit 0
fi

if ! command -v metapac >/dev/null 2>&1; then
    echo "metapac not installed; skipping package sync" >&2
    echo "  cargo install metapac --locked" >&2
    exit 0
fi

exec metapac --config-dir "${XDG_CONFIG_HOME:-$HOME/.config}/metapac" sync --no-confirm
